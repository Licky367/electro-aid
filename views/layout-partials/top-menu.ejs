<!-- =========================================================
   TOP MENU
========================================================= -->

<div class="top-menu">


<% if(isDairyWorker){ %>


    <!-- =====================================================
       DAIRY WORKER TOP NAVIGATION
    ====================================================== -->

    <div class="dairy-worker-nav">


        <a href="<%= homeLink %>">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🏠
            </span>

            <span class="nav-label">
                Home
            </span>

        </a>


        <a href="/milk">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🥛
            </span>

            <span class="nav-label">
                Production
            </span>

        </a>


        <a href="/milk/sales">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                💰
            </span>

            <span class="nav-label">
                Sales
            </span>

        </a>


        <% if(user && user.role !== "admin"){ %>

        <a href="/extra/<%= user._id %>">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                ✨
            </span>

            <span class="nav-label">
                Extras
            </span>

        </a>

        <% } %>


    </div>


<% }else if(isAdmin){ %>


    <!-- =====================================================
       ADMIN TOP NAVIGATION
    ====================================================== -->

    <button
        type="button"
        id="adminTopMenuButton"
        class="menu-btn"
        aria-label="Open admin navigation menu"
        aria-expanded="false"
        title="Menu"
    >

        ☰

    </button>


    <div class="dairy-worker-nav">


        <a href="/milk">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🥛
            </span>

            <span class="nav-label">
                Production
            </span>

        </a>


        <a href="/milk/sales">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                💰
            </span>

            <span class="nav-label">
                Sales
            </span>

        </a>


        <a href="/stats">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                📊
            </span>

            <span class="nav-label">
                Stats
            </span>

        </a>


    </div>


<% }else{ %>


    <!-- =====================================================
       POULTRY WORKER MENU BUTTON
    ====================================================== -->

    <button
        type="button"
        class="menu-btn"
        onclick="openSidebar()"
        aria-label="Open menu"
        title="Menu"
    >

        ☰

    </button>


    <!-- =====================================================
       NON-ADMIN EXTRAS
    ====================================================== -->

    <% if(user && user.role !== "admin"){ %>

    <div class="dairy-worker-nav">

        <a href="/extra/<%= user._id %>">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                ✨
            </span>

            <span class="nav-label">
                Extras
            </span>

        </a>

    </div>

    <% } %>


<% } %>


<!-- =========================================================
   PROFILE
========================================================= -->

<div
    class="profile-box"
    id="profileBox"
>

    <div
        class="profile-trigger"
        onclick="toggleProfile(event)"
        role="button"
        tabindex="0"
        aria-label="Open profile menu"
    >

        <span
            class="profile-icon"
            aria-hidden="true"
        >
            👤
        </span>

        <span class="profile-name">
            Profile
        </span>

    </div>


    <div class="dropdown-profile">


        <% if(user){ %>


            <a href="/profile">
                👤 My Account
            </a>


            <% if(isAdmin){ %>

                <a href="/accounts">
                    👥 People
                </a>

            <% } %>


            <a href="/logout">
                🚪 Logout
            </a>


        <% } %>


    </div>

</div>


</div>


<!-- =========================================================
   ADMIN SIDEBAR
========================================================= -->

<% if(isAdmin){ %>


<aside
    id="adminDashboardSidebar"
    class="admin-dashboard-sidebar"
    aria-label="Project navigation"
    aria-expanded="false"
>


    <ul class="admin-sidebar-menu">


        <li class="admin-sidebar-item">

            <button
                type="button"
                id="adminSidebarMenuButton"
                class="admin-sidebar-menu-button"
                aria-label="Close navigation menu"
                aria-expanded="true"
            >

                <span
                    class="admin-sidebar-menu-icon"
                    aria-hidden="true"
                >
                    ☰
                </span>

                <span class="admin-sidebar-label">
                    Menu
                </span>

            </button>

        </li>


        <li class="admin-sidebar-item">

            <a
                href="<%= homeLink %>"
                class="admin-sidebar-link active"
                title="Dashboard"
            >

                <span
                    class="admin-sidebar-icon"
                    aria-hidden="true"
                >
                    ⌂
                </span>

                <span class="admin-sidebar-label">
                    Dashboard
                </span>

            </a>

        </li>


        <li class="admin-sidebar-item">

            <button
                type="button"
                id="dairyActivitiesButton"
                class="admin-sidebar-section-button"
                aria-expanded="false"
                aria-controls="dairyActivitiesSubmenu"
            >

                <span
                    class="admin-sidebar-icon"
                    aria-hidden="true"
                >
                    🐄
                </span>

                <span class="admin-sidebar-label">
                    Dairy Activities
                </span>

                <span
                    class="admin-sidebar-section-arrow"
                    aria-hidden="true"
                >
                    ▶
                </span>

            </button>


            <ul
                id="dairyActivitiesSubmenu"
                class="admin-sidebar-submenu"
            >


                <li class="admin-sidebar-item">

                    <a
                        href="/add"
                        class="admin-sidebar-link"
                        title="Add an Asset"
                    >

                        <span
                            class="admin-sidebar-icon"
                            aria-hidden="true"
                        >
                            ＋
                        </span>

                        <span class="admin-sidebar-label">
                            Add an Asset
                        </span>

                    </a>

                </li>


                <li class="admin-sidebar-item">

                    <a
                        href="/milk"
                        class="admin-sidebar-link"
                        title="Record Milk Production"
                    >

                        <span
                            class="admin-sidebar-icon"
                            aria-hidden="true"
                        >
                            🥛
                        </span>

                        <span class="admin-sidebar-label">
                            Record Milk Production
                        </span>

                    </a>

                </li>


                <li class="admin-sidebar-item">

                    <a
                        href="/milk/sales"
                        class="admin-sidebar-link"
                        title="Record Milk Sales"
                    >

                        <span
                            class="admin-sidebar-icon"
                            aria-hidden="true"
                        >
                            💰
                        </span>

                        <span class="admin-sidebar-label">
                            Record Milk Sales
                        </span>

                    </a>

                </li>


                <li class="admin-sidebar-item">

                    <a
                        href="/stats"
                        class="admin-sidebar-link"
                        title="Milk Statistics"
                    >

                        <span
                            class="admin-sidebar-icon"
                            aria-hidden="true"
                        >
                            📊
                        </span>

                        <span class="admin-sidebar-label">
                            Milk Statistics
                        </span>

                    </a>

                </li>


            </ul>

        </li>


        <li class="admin-sidebar-item">

            <a
                href="/networth"
                class="admin-sidebar-link"
                title="View Assets"
            >

                <span
                    class="admin-sidebar-icon"
                    aria-hidden="true"
                >
                    👁
                </span>

                <span class="admin-sidebar-label">
                    View Assets
                </span>

            </a>

        </li>


        <li class="admin-sidebar-item">

            <a
                href="/financials/summary"
                class="admin-sidebar-link"
                title="Financials"
            >

                <span
                    class="admin-sidebar-icon"
                    aria-hidden="true"
                >
                    💱
                </span>

                <span class="admin-sidebar-label">
                    Financials
                </span>

            </a>

        </li>


    </ul>


    <div class="admin-sidebar-footer">

        Chesi Project Management System

    </div>


</aside>


<div
    id="adminSidebarOverlay"
    class="admin-sidebar-overlay"
    aria-hidden="true"
></div>


<% } %>


<!-- =========================================================
   POULTRY WORKER SIDEBAR
========================================================= -->

<% if(isPoultryWorker){ %>


<div
    class="sidebar"
    id="sidebar"
>


    <a href="/">
        🏠 Home
    </a>


    <a href="/incubation">
        🥚 Incubate Eggs
    </a>


    <a href="/nursing">
        🐣 Poultry Progress
    </a>


    <a href="/cage">
        🐔 Caged Chicken
    </a>


    <a href="/poultry-stats">
        📊 Track Production
    </a>


    <a href="/eggs">
        🥚 Sell Eggs
    </a>


</div>


<div
    class="overlay"
    id="overlay"
></div>


<% } %>