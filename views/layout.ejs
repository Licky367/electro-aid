<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>
    <%= typeof title !== "undefined" ? title : "Chesi Projects" %>
</title>

<link
    rel="icon"
    type="image/png"
    href="/images/cfp-logo.png"
>

<link
    rel="stylesheet"
    href="/css/layout.css"
>

<meta
    property="og:title"
    content="<%= typeof title !== "undefined" ? title : "Chesi Projects" %>"
>

<meta
    property="og:description"
    content="Chesi Projects Management System"
>

<meta
    property="og:image"
    content="https://YOUR-DOMAIN.com/images/cfp-logo.png"
>

<meta
    property="og:url"
    content="https://YOUR-DOMAIN.com<%= currentPath || "/" %>"
>

<meta
    property="og:type"
    content="website"
>

<meta
    property="og:site_name"
    content="Chesi Projects"
>

<meta
    name="twitter:card"
    content="summary_large_image"
>

<meta
    name="twitter:title"
    content="<%= typeof title !== "undefined" ? title : "Chesi Projects" %>"
>

<meta
    name="twitter:description"
    content="Chesi Projects Management System"
>

<meta
    name="twitter:image"
    content="https://YOUR-DOMAIN.com/images/cfp-logo.png"
>

</head>


<%

/* =========================================================
   AUTHENTICATION PAGES
========================================================= */

const authPages = [
    "/login",
    "/signup",
    "/forgot-password",
    "/reset-password"
];

const currentPagePath =
    currentPath ||
    (typeof req !== "undefined" && req.path) ||
    "";

const isAuthPage =
    authPages.includes(
        currentPagePath
    );


/* =========================================================
   HOME DESTINATION
========================================================= */

let homeLink = "/";


/* =========================================================
   ADMIN
========================================================= */

if(
    user &&
    user.role === "admin"
){

    homeLink =
        "/dashboard/dairy";

}


/* =========================================================
   DAIRY WORKER
========================================================= */

else if(
    user &&
    user.role === "dairyWorker" &&
    Array.isArray(user.assignedFarm) &&
    user.assignedFarm.length > 0
){

    const firstFarm =
        user.assignedFarm[0];

    homeLink =
        `/dairy/${firstFarm}`;

}


/* =========================================================
   HEADER TITLE
========================================================= */

let headerTitle =
    "CHESI PROJECTS";

if(user){

    if(
        user.role === "dairyWorker"
    ){

        headerTitle =
            "DAIRY ACTIVITIES";

    }

    else if(
        user.role === "poultryWorker"
    ){

        headerTitle =
            "POULTRY ACTIVITIES";

    }

    else if(
        user.role === "admin"
    ){

        headerTitle =
            "CHESI PROJECTS";

    }

}


/* =========================================================
   ROLE FLAGS
========================================================= */

const isAdmin =
    !!user &&
    user.role === "admin";

const isDairyWorker =
    !!user &&
    user.role === "dairyWorker";

const isPoultryWorker =
    !!user &&
    user.role === "poultryWorker";

%>


<body class="<%= isAuthPage ? 'auth-page' : 'app-page' %>">


<% if(!isAuthPage){ %>


    <!-- =====================================================
       HEADER
    ====================================================== -->

    <%- include("layout-partials/header") %>


    <!-- =====================================================
       TOP MENU + SIDE BARS
    ====================================================== -->

    <%- include("layout-partials/top-menu") %>


<% } %>


<!-- =========================================================
   MAIN CONTENT
========================================================= -->

<div class="main">

    <%- body %>

</div>


<!-- =========================================================
   FOOTER
========================================================= -->

<%- include("layout-partials/footer") %>


</body>

</html>