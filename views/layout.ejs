<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>
    <%= typeof title !== "undefined" ? title : "Chesi Projects" %>
</title>

<link
    rel="icon"
    type="image/png"
    href="/images/cfp-logo.png"
>

<link
    rel="stylesheet"
    href="/css/layout.css"
>

<meta
    property="og:title"
    content="<%= typeof title !== "undefined" ? title : "Chesi Projects" %>"
>

<meta
    property="og:description"
    content="Chesi Projects Management System"
>

<meta
    property="og:image"
    content="https://YOUR-DOMAIN.com/images/cfp-logo.png"
>

<meta
    property="og:url"
    content="https://YOUR-DOMAIN.com<%= currentPath || "/" %>"
>

<meta
    property="og:type"
    content="website"
>

<meta
    property="og:site_name"
    content="Chesi Projects"
>

<meta
    name="twitter:card"
    content="summary_large_image"
>

<meta
    name="twitter:title"
    content="<%= typeof title !== "undefined" ? title : "Chesi Projects" %>"
>

<meta
    name="twitter:description"
    content="Chesi Projects Management System"
>

<meta
    name="twitter:image"
    content="https://YOUR-DOMAIN.com/images/cfp-logo.png"
>

</head>


<%

/* =========================================================
   AUTHENTICATION PAGES
========================================================= */

const authPages = [
    "/login",
    "/signup",
    "/forgot-password",
    "/reset-password"
];

const currentPagePath =
    currentPath ||
    (typeof req !== "undefined" && req.path) ||
    "";

const isAuthPage =
    authPages.includes(
        currentPagePath
    );

%>


<body class="<%= isAuthPage ? 'auth-page' : 'app-page' %>">


<%

/* =========================================================
   HOME DESTINATION
========================================================= */

let homeLink = "/";


/* =========================================================
   ADMIN
========================================================= */

if(
    user &&
    user.role === "admin"
){

    homeLink =
        "/dashboard/dairy";

}


/* =========================================================
   DAIRY WORKER
========================================================= */

else if(
    user &&
    user.role === "dairyWorker" &&
    Array.isArray(user.assignedFarm) &&
    user.assignedFarm.length > 0
){

    const firstFarm =
        user.assignedFarm[0];

    homeLink =
        `/dairy/${firstFarm}`;

}


/* =========================================================
   HEADER TITLE
========================================================= */

let headerTitle =
    "CHESI PROJECTS";

if(user){

    if(
        user.role === "dairyWorker"
    ){

        headerTitle =
            "DAIRY ACTIVITIES";

    }

    else if(
        user.role === "poultryWorker"
    ){

        headerTitle =
            "POULTRY ACTIVITIES";

    }

    else if(
        user.role === "admin"
    ){

        headerTitle =
            "CHESI PROJECTS";

    }

}


/* =========================================================
   ROLE FLAGS
========================================================= */

const isAdmin =
    !!user &&
    user.role === "admin";

const isDairyWorker =
    !!user &&
    user.role === "dairyWorker";

const isPoultryWorker =
    !!user &&
    user.role === "poultryWorker";

%>


<% if(!isAuthPage){ %>


<!-- =========================================================
   HEADER
========================================================= -->

<div class="header">


    <!-- =====================================================
       LOGO
    ====================================================== -->

    <a
        href="<%= homeLink %>"
        class="header-logo-link"
        aria-label="Home"
    >

        <img
            src="/images/cfp-logo.png"
            alt="CFP Logo"
            class="header-logo"
        >

    </a>


    <!-- =====================================================
       HEADER TITLE
    ====================================================== -->

    <div class="header-title">

        <span class="header-title-text">
            <%= headerTitle %>
        </span>

    </div>


</div>


<!-- =========================================================
   TOP MENU
========================================================= -->

<div class="top-menu">


<% if(isDairyWorker){ %>


    <!-- =====================================================
       DAIRY WORKER TOP NAVIGATION
    ====================================================== -->

    <div class="dairy-worker-nav">


        <a href="<%= homeLink %>">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🏠
            </span>

            <span class="nav-label">
                Home
            </span>

        </a>


        <a href="/milk">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🥛
            </span>

            <span class="nav-label">
                Production
            </span>

        </a>


        <a href="/milk/sales">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                💰
            </span>

            <span class="nav-label">
                Sales
            </span>

        </a>


        <% if(user && user.role !== "admin"){ %>

        <a href="/extra/<%= user._id %>">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                ✨
            </span>

            <span class="nav-label">
                Extras
            </span>

        </a>

        <% } %>


    </div>


<% }else if(isAdmin){ %>


    <!-- =====================================================
       ADMIN TOP NAVIGATION
    ====================================================== -->

    <button
        type="button"
        id="adminTopMenuButton"
        class="menu-btn"
        aria-label="Open admin navigation menu"
        aria-expanded="false"
        title="Menu"
    >

        ☰

    </button>


    <div class="dairy-worker-nav">


        <a href="/milk">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🥛
            </span>

            <span class="nav-label">
                Production
            </span>

        </a>


        <a href="/milk/sales">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                💰
            </span>

            <span class="nav-label">
                Sales
            </span>

        </a>


        <a href="/stats">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                📊
            </span>

            <span class="nav-label">
                Stats
            </span>

        </a>


    </div>


<% }else{ %>


    <!-- =====================================================
       POULTRY WORKER MENU BUTTON
    ====================================================== -->

    <button
        type="button"
        class="menu-btn"
        onclick="openSidebar()"
        aria-label="Open menu"
        title="Menu"
    >

        ☰

    </button>


    <!-- =====================================================
       NON-ADMIN EXTRAS
    ====================================================== -->

    <% if(user && user.role !== "admin"){ %>

    <div class="dairy-worker-nav">

        <a href="/extra/<%= user._id %>">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                ✨
            </span>

            <span class="nav-label">
                Extras
            </span>

        </a>

    </div>

    <% } %>


<% } %>


<!-- =========================================================
   PROFILE
========================================================= -->

<div
    class="profile-box"
    id="profileBox"
>

    <div
        class="profile-trigger"
        onclick="toggleProfile(event)"
        role="button"
        tabindex="0"
        aria-label="Open profile menu"
    >

        <span
            class="profile-icon"
            aria-hidden="true"
        >
            👤
        </span>

        <span class="profile-name">
            Profile
        </span>

    </div>


    <div class="dropdown-profile">


        <% if(user){ %>


            <a href="/profile">
                👤 My Account
            </a>


            <% if(isAdmin){ %>

                <a href="/accounts">
                    👥 People
                </a>

            <% } %>


            <a href="/logout">
                🚪 Logout
            </a>


        <% } %>


    </div>

</div>


</div>


<!-- =========================================================
   ADMIN SIDEBAR
========================================================= -->

<% if(isAdmin){ %>


<aside
    id="adminDashboardSidebar"
    class="admin-dashboard-sidebar"
    aria-label="Project navigation"
    aria-expanded="false"
>


    <ul class="admin-sidebar-menu">


        <li class="admin-sidebar-item">

            <button
                type="button"
                id="adminSidebarMenuButton"
                class="admin-sidebar-menu-button"
                aria-label="Close navigation menu"
                aria-expanded="true"
            >

                <span
                    class="admin-sidebar-menu-icon"
                    aria-hidden="true"
                >
                    ☰
                </span>

                <span class="admin-sidebar-label">
                    Menu
                </span>

            </button>

        </li>


        <li class="admin-sidebar-item">

            <a
                href="<%= homeLink %>"
                class="admin-sidebar-link active"
                title="Dashboard"
            >

                <span
                    class="admin-sidebar-icon"
                    aria-hidden="true"
                >
                    ⌂
                </span>

                <span class="admin-sidebar-label">
                    Dashboard
                </span>

            </a>

        </li>


        <li class="admin-sidebar-item">

            <button
                type="button"
                id="dairyActivitiesButton"
                class="admin-sidebar-section-button"
                aria-expanded="false"
                aria-controls="dairyActivitiesSubmenu"
            >

                <span
                    class="admin-sidebar-icon"
                    aria-hidden="true"
                >
                    🐄
                </span>

                <span class="admin-sidebar-label">
                    Dairy Activities
                </span>

                <span
                    class="admin-sidebar-section-arrow"
                    aria-hidden="true"
                >
                    ▶
                </span>

            </button>


            <ul
                id="dairyActivitiesSubmenu"
                class="admin-sidebar-submenu"
            >


                <li class="admin-sidebar-item">

                    <a
                        href="/add"
                        class="admin-sidebar-link"
                        title="Add an Asset"
                    >

                        <span
                            class="admin-sidebar-icon"
                            aria-hidden="true"
                        >
                            ＋
                        </span>

                        <span class="admin-sidebar-label">
                            Add an Asset
                        </span>

                    </a>

                </li>


                <li class="admin-sidebar-item">

                    <a
                        href="/milk"
                        class="admin-sidebar-link"
                        title="Record Milk Production"
                    >

                        <span
                            class="admin-sidebar-icon"
                            aria-hidden="true"
                        >
                            🥛
                        </span>

                        <span class="admin-sidebar-label">
                            Record Milk Production
                        </span>

                    </a>

                </li>


                <li class="admin-sidebar-item">

                    <a
                        href="/milk/sales"
                        class="admin-sidebar-link"
                        title="Record Milk Sales"
                    >

                        <span
                            class="admin-sidebar-icon"
                            aria-hidden="true"
                        >
                            💰
                        </span>

                        <span class="admin-sidebar-label">
                            Record Milk Sales
                        </span>

                    </a>

                </li>


                <li class="admin-sidebar-item">

                    <a
                        href="/stats"
                        class="admin-sidebar-link"
                        title="Milk Statistics"
                    >

                        <span
                            class="admin-sidebar-icon"
                            aria-hidden="true"
                        >
                            📊
                        </span>

                        <span class="admin-sidebar-label">
                            Milk Statistics
                        </span>

                    </a>

                </li>


            </ul>

        </li>


        <li class="admin-sidebar-item">

            <a
                href="/networth"
                class="admin-sidebar-link"
                title="View Assets"
            >

                <span
                    class="admin-sidebar-icon"
                    aria-hidden="true"
                >
                    👁
                </span>

                <span class="admin-sidebar-label">
                    View Assets
                </span>

            </a>

        </li>


        <li class="admin-sidebar-item">

            <a
                href="/financials/summary"
                class="admin-sidebar-link"
                title="Financials"
            >

                <span
                    class="admin-sidebar-icon"
                    aria-hidden="true"
                >
                    💱
                </span>

                <span class="admin-sidebar-label">
                    Financials
                </span>

            </a>

        </li>


    </ul>


    <div class="admin-sidebar-footer">

        Chesi Project Management System

    </div>


</aside>


<div
    id="adminSidebarOverlay"
    class="admin-sidebar-overlay"
    aria-hidden="true"
></div>


<% } %>


<!-- =========================================================
   POULTRY WORKER SIDEBAR
========================================================= -->

<% if(isPoultryWorker){ %>


<div
    class="sidebar"
    id="sidebar"
>


    <a href="/">
        🏠 Home
    </a>


    <a href="/incubation">
        🥚 Incubate Eggs
    </a>


    <a href="/nursing">
        🐣 Poultry Progress
    </a>


    <a href="/cage">
        🐔 Caged Chicken
    </a>


    <a href="/poultry-stats">
        📊 Track Production
    </a>


    <a href="/eggs">
        🥚 Sell Eggs
    </a>


</div>


<div
    class="overlay"
    id="overlay"
></div>


<% } %>


<% } %>


<!-- =========================================================
   MAIN CONTENT
========================================================= -->

<div class="main">

    <%- body %>

</div>


<!-- =========================================================
   FOOTER
========================================================= -->

<div class="footer">

    © <%= new Date().getFullYear() %>
    Dr. Chessy Edwin

</div>


<% if(!isAuthPage){ %>


<script>

/* =========================================================
   PROFILE
========================================================= */

const profileBox =
    document.getElementById(
        "profileBox"
    );


function toggleProfile(event){

    event.stopPropagation();

    if(profileBox){

        profileBox.classList.toggle(
            "active"
        );

    }

}


/* =========================================================
   POULTRY SIDEBAR
========================================================= */

const poultrySidebar =
    document.getElementById(
        "sidebar"
    );

const poultryOverlay =
    document.getElementById(
        "overlay"
    );


function openSidebar(){

    if(
        !poultrySidebar ||
        !poultryOverlay
    ){

        return;

    }

    poultrySidebar.classList.add(
        "active"
    );

    poultryOverlay.classList.add(
        "active"
    );

}


function closeSidebar(){

    if(
        !poultrySidebar ||
        !poultryOverlay
    ){

        return;

    }

    poultrySidebar.classList.remove(
        "active"
    );

    poultryOverlay.classList.remove(
        "active"
    );

}


if(poultryOverlay){

    poultryOverlay.addEventListener(
        "click",
        closeSidebar
    );

}


if(poultrySidebar){

    poultrySidebar
        .querySelectorAll("a")
        .forEach(
            function(link){

                link.addEventListener(
                    "click",
                    closeSidebar
                );

            }
        );

}


/* =========================================================
   ADMIN SIDEBAR
========================================================= */

const adminSidebar =
    document.getElementById(
        "adminDashboardSidebar"
    );

const adminTopMenuButton =
    document.getElementById(
        "adminTopMenuButton"
    );

const adminSidebarMenuButton =
    document.getElementById(
        "adminSidebarMenuButton"
    );

const adminSidebarOverlay =
    document.getElementById(
        "adminSidebarOverlay"
    );

const dairyActivitiesButton =
    document.getElementById(
        "dairyActivitiesButton"
    );

const dairyActivitiesSubmenu =
    document.getElementById(
        "dairyActivitiesSubmenu"
    );


/* =========================================================
   OPEN ADMIN SIDEBAR
========================================================= */

function openAdminSidebar(){

    if(
        !adminSidebar ||
        !adminSidebarOverlay
    ){

        return;

    }

    adminSidebar.classList.add(
        "open"
    );

    adminSidebarOverlay.classList.add(
        "active"
    );

    adminSidebar.setAttribute(
        "aria-expanded",
        "true"
    );

    if(adminTopMenuButton){

        adminTopMenuButton.setAttribute(
            "aria-expanded",
            "true"
        );

    }

    adminSidebarOverlay.setAttribute(
        "aria-hidden",
        "false"
    );

}


/* =========================================================
   CLOSE DAIRY ACTIVITIES
========================================================= */

function closeDairyActivities(){

    if(
        !dairyActivitiesButton ||
        !dairyActivitiesSubmenu
    ){

        return;

    }

    dairyActivitiesButton.setAttribute(
        "aria-expanded",
        "false"
    );

    dairyActivitiesButton.classList.remove(
        "expanded"
    );

    dairyActivitiesSubmenu.classList.remove(
        "open"
    );

}


/* =========================================================
   CLOSE ADMIN SIDEBAR
========================================================= */

function closeAdminSidebar(){

    if(
        !adminSidebar ||
        !adminSidebarOverlay
    ){

        return;

    }

    adminSidebar.classList.remove(
        "open"
    );

    adminSidebarOverlay.classList.remove(
        "active"
    );

    adminSidebar.setAttribute(
        "aria-expanded",
        "false"
    );

    if(adminTopMenuButton){

        adminTopMenuButton.setAttribute(
            "aria-expanded",
            "false"
        );

    }

    adminSidebarOverlay.setAttribute(
        "aria-hidden",
        "true"
    );

    closeDairyActivities();

}


/* =========================================================
   ADMIN TOP MENU BUTTON
========================================================= */

if(adminTopMenuButton){

    adminTopMenuButton.addEventListener(
        "click",
        function(event){

            event.preventDefault();

            event.stopPropagation();

            if(
                adminSidebar &&
                adminSidebar.classList.contains(
                    "open"
                )
            ){

                closeAdminSidebar();

            }

            else{

                openAdminSidebar();

            }

        }
    );

}


/* =========================================================
   ADMIN SIDEBAR MENU BUTTON
========================================================= */

if(adminSidebarMenuButton){

    adminSidebarMenuButton.addEventListener(
        "click",
        function(event){

            event.preventDefault();

            event.stopPropagation();

            closeAdminSidebar();

        }
    );

}


/* =========================================================
   DAIRY ACTIVITIES
========================================================= */

if(
    dairyActivitiesButton &&
    dairyActivitiesSubmenu
){

    dairyActivitiesButton.addEventListener(
        "click",
        function(event){

            event.preventDefault();

            event.stopPropagation();

            const isExpanded =
                dairyActivitiesButton.getAttribute(
                    "aria-expanded"
                ) === "true";

            dairyActivitiesButton.setAttribute(
                "aria-expanded",
                String(!isExpanded)
            );

            dairyActivitiesButton.classList.toggle(
                "expanded",
                !isExpanded
            );

            dairyActivitiesSubmenu.classList.toggle(
                "open",
                !isExpanded
            );

        }
    );

}


/* =========================================================
   ADMIN SIDEBAR LINKS
========================================================= */

if(adminSidebar){

    adminSidebar
        .querySelectorAll(
            ".admin-sidebar-link"
        )
        .forEach(
            function(link){

                link.addEventListener(
                    "click",
                    function(){

                        closeAdminSidebar();

                    }
                );

            }
        );

}


/* =========================================================
   ADMIN OVERLAY
========================================================= */

if(adminSidebarOverlay){

    adminSidebarOverlay.addEventListener(
        "click",
        function(){

            closeAdminSidebar();

        }
    );

}


/* =========================================================
   CLOSE PROFILE WHEN CLICKING OUTSIDE
========================================================= */

document.addEventListener(
    "click",
    function(event){

        if(
            profileBox &&
            !profileBox.contains(
                event.target
            )
        ){

            profileBox.classList.remove(
                "active"
            );

        }

    }
);


/* =========================================================
   ESCAPE KEY
========================================================= */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            closeSidebar();

            closeAdminSidebar();

            if(profileBox){

                profileBox.classList.remove(
                    "active"
                );

            }

        }

    }
);


/* =========================================================
   WINDOW RESIZE
========================================================= */

window.addEventListener(
    "resize",
    function(){

        closeAdminSidebar();

        closeSidebar();

    }
);

</script>


<% } %>


</body>

</html>